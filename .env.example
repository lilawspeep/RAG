# ─────────────────────────────────────────────────────────────
# Frontend (Vite) — copy to .env.local. Only PUBLIC values here.
# The anon key is designed to be public; security is enforced by RLS.
# ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────
# Supabase Edge Function secrets — NEVER put these in .env.local.
# Set with:  supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are
#  injected automatically by Supabase in deployed functions.)
# ─────────────────────────────────────────────────────────────

# Embeddings — any OpenAI-compatible /embeddings endpoint.
# The database column is vector(1536); the model must output 1536 dims
# (text-embedding-3-small does by default) or change the migration.
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# Chat model — any OpenAI-compatible /chat/completions endpoint.
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Retrieval tuning (optional)
RAG_MATCH_COUNT=8
RAG_MIN_SIMILARITY=0.30

# Comma-separated list of allowed browser origins for the edge functions
# (e.g. http://localhost:5173,https://your-domain). "*" allows any origin.
ALLOWED_ORIGINS=*
